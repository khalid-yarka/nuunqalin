# ============================================
# NUUNPLATFORM ENVIRONMENT VARIABLES
# ============================================

# ============================================
# REQUIRED
# ============================================

SECRET_KEY=your-super-secret-key-change-this-in-production
BACKUP_TRIGGER_TOKEN=your-backup-token-change-this-in-production

# ADMIN ERROR DASHBOARD PASSWORD
# Use a strong password (20+ chars, mixed case, numbers, symbols)
ADMIN_ERROR_PASSWORD=your-strong-admin-password-here

# ============================================
# PATHS (Relative to project root)
# ============================================

DATABASE_PATH=nuunplatform.db
BACKUP_DIR=BACKUPS
LOG_DIR=logs
UPLOAD_FOLDER=static/uploads/pdfs

# ============================================
# DATABASE SETTINGS
# ============================================

DB_TIMEOUT=30.0
DB_BUSY_TIMEOUT=30000
DB_RETRY_ATTEMPTS=7
DB_RETRY_INITIAL_DELAY=0.1
DB_MAX_RETRY_DELAY=3.0
DB_RETRY_BACKOFF_MULTIPLIER=2.0

# ============================================
# BACKUP SETTINGS
# ============================================

BACKUP_ENABLED=true
BACKUP_RETENTION_DAILY=7
BACKUP_RETENTION_WEEKLY=4
BACKUP_RETENTION_MONTHLY=12

# ============================================
# QUIZ SETTINGS
# ============================================

RATING_TIME=10
LIVE_QUIZ_TIME_PER_QUESTION=30
LIVE_QUIZ_MAX_PARTICIPANTS=50

# ============================================
# SESSION SECURITY
# ============================================

SESSION_COOKIE_SECURE=false
PERMANENT_SESSION_LIFETIME=86400
ADMIN_SESSION_TIMEOUT=1800

# ============================================
# RATE LIMITING
# ============================================

RATE_LIMIT_DEFAULT=200 per day;50 per hour
RATE_LIMIT_LOGIN=5 per minute
RATE_LIMIT_ADMIN=10 per minute

# ============================================
# LOGGING
# ============================================

LOG_LEVEL=WARNING
LOG_MAX_BYTES=10485760
LOG_BACKUP_COUNT=5

# Error retention in days
ERROR_RETENTION_DAYS=30

# Email deduplication window (seconds)
ERROR_EMAIL_DEDUP_WINDOW=300

# ============================================
# EMAIL CONFIGURATION
# ============================================

SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=khaalidyarka@gmail.com
SMTP_PASSWORD=your-gmail-app-password-here
SMTP_FROM=khaalidyarka@gmail.com
SMTP_TO=khaalidyarka@gmail.com

# ============================================
# FLASK
# ============================================

FLASK_DEBUG=false
PORT=5000