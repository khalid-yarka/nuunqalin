# ============================================
# NUUNPLATFORM ENVIRONMENT VARIABLES
# ============================================

# Required
SECRET_KEY=your-super-secret-key-change-this-in-production
DATABASE_PATH=nuunplatform.db
BACKUP_TRIGGER_TOKEN=your-backup-token-change-this-in-production

# Optional - App Settings
FLASK_DEBUG=false
PORT=5000

# Database Settings
DB_TIMEOUT=10.0
DB_BUSY_TIMEOUT=10000
DB_RETRY_ATTEMPTS=3
DB_RETRY_DELAY=0.1

# Backup Settings
BACKUP_DIR=BACKUPS
BACKUP_ENABLED=true

# Quiz Settings
RATING_TIME=10
LIVE_QUIZ_TIME_PER_QUESTION=30
LIVE_QUIZ_MAX_PARTICIPANTS=50

# Session Security
SESSION_COOKIE_SECURE=false  # Set to true in production with HTTPS
PERMANENT_SESSION_LIFETIME=86400  # 24 hours in seconds

# Rate Limiting (if using flask-limiter)
RATE_LIMIT_DEFAULT=200 per day;50 per hour
RATE_LIMIT_LOGIN=5 per minute