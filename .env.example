# ============================================
# NUUNPLATFORM ENVIRONMENT VARIABLES
# ============================================

# ============================================
# REQUIRED
# ============================================

SECRET_KEY=your-super-secret-key-change-this-in-production
BACKUP_TRIGGER_TOKEN=your-backup-token-change-this-in-production

# ============================================
# PATHS (Relative to project root)
# ============================================

# Database - relative or absolute
DATABASE_PATH=nuunplatform.db

# Backup directory
BACKUP_DIR=BACKUPS

# Log directory
LOG_DIR=logs

# Upload folder
UPLOAD_FOLDER=static/uploads/pdfs

# ============================================
# DATABASE SETTINGS
# ============================================

DB_TIMEOUT=30.0
DB_BUSY_TIMEOUT=30000
DB_RETRY_ATTEMPTS=7
DB_RETRY_INITIAL_DELAY=0.1
DB_MAX_RETRY_DELAY=3.0
DB_RETRY_BACKOFF_MULTIPLIER=2.0

# ============================================
# BACKUP SETTINGS
# ============================================

BACKUP_ENABLED=true
BACKUP_RETENTION_DAILY=7
BACKUP_RETENTION_WEEKLY=4
BACKUP_RETENTION_MONTHLY=12

# ============================================
# QUIZ SETTINGS
# ============================================

RATING_TIME=10
LIVE_QUIZ_TIME_PER_QUESTION=30
LIVE_QUIZ_MAX_PARTICIPANTS=50

# ============================================
# SESSION SECURITY
# ============================================

SESSION_COOKIE_SECURE=false  # Set to true in production with HTTPS
PERMANENT_SESSION_LIFETIME=86400  # 24 hours in seconds

# ============================================
# RATE LIMITING (if using flask-limiter)
# ============================================

RATE_LIMIT_DEFAULT=200 per day;50 per hour
RATE_LIMIT_LOGIN=5 per minute

# ============================================
# LOGGING
# ============================================

LOG_LEVEL=WARNING
LOG_MAX_BYTES=10485760  # 10MB
LOG_BACKUP_COUNT=5

# ============================================
# FLASK
# ============================================

FLASK_DEBUG=false
PORT=5000